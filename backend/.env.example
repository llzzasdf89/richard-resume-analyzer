# AI model through Alibaba Cloud DashScope.
# Get the key from https://bailian.console.aliyun.com
API_KEY=

# Model API base URL.
BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# Model name.
MODEL_NAME=qwen-max

# PostgreSQL with pgvector.
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

# Allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Supabase JWT secret for backend access-token verification.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Langfuse observability.
# Get keys from https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Tavily search API for agent tools.
# Get the key from https://app.tavily.com
TAVILY_API_KEY=
